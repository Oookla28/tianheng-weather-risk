# Copy to a private runtime environment; do not commit real tokens.
# The CMA data service issues the endpoint/file URL after real-name access.
CMA_RADAR_ENDPOINT=https://<authorised-cma-endpoint>
CMA_RADAR_TOKEN=<runtime-secret>
CMA_RADAR_PRODUCT=reflectivity
CMA_RADAR_DATA_CODE=J.0019.0010.S001
# Example format: (20261030000000,20261030000600]
CMA_RADAR_TIME_RANGE=
CMA_RADAR_STATION_IDS=
CMA_RADAR_TIMEOUT=8
CMA_RADAR_MAX_CACHE_AGE=1800

# Use a city/Jilin public-data interface or an authorised municipal export.
CHANGCHUN_DRAINAGE_ENDPOINT=https://<authorised-changchun-feed>
CHANGCHUN_DRAINAGE_TOKEN=<runtime-secret>
CHANGCHUN_DRAINAGE_DEPTH_UNIT=cm
CHANGCHUN_DRAINAGE_TIMEOUT=8
CHANGCHUN_DRAINAGE_MAX_CACHE_AGE=1800
